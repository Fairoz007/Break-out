extends Node
## Read-only access to canonical Chapter 1 data exported from the docs (REQ-ARCH-003).
## data/ch01/*.json is generated by tools/phase02_export_data.py; never edited by hand.

var lines := {}      # id -> line dictionary
var shots := {}      # id -> shot dictionary
var missions := []   # ordered mission dictionaries


func _ready() -> void:
	for l in _load("res://data/ch01/dialogue.json")["lines"]:
		lines[l["id"]] = l
	for s in _load("res://data/ch01/shots.json")["shots"]:
		shots[s["id"]] = s
	missions = _load("res://data/ch01/missions.json")["missions"]


func _load(path: String) -> Dictionary:
	var f := FileAccess.open(path, FileAccess.READ)
	assert(f != null, "Missing data file " + path)
	return JSON.parse_string(f.get_as_text())


func line(id: String) -> Dictionary:
	assert(lines.has(id), "Unknown dialogue line " + id)
	return lines[id]


func shot(id: String) -> Dictionary:
	assert(shots.has(id), "Unknown shot " + id)
	return shots[id]


func mission(index: int) -> Dictionary:
	return missions[index - 1]


func objective_text(objective_id: String) -> String:
	for m in missions:
		for o in m["objectives"]:
			if o["id"] == objective_id:
				return o["text"]
	return objective_id


func lines_for(mission_index: int) -> Array:
	var out := []
	for id in lines:
		if lines[id]["mission"] == mission_index:
			out.append(id)
	out.sort()
	return out
